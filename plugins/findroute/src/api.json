{
  "url": {
    "name": "findroute",
    "separator": "*"
  },
  "constructor": "IDEE.plugin.Findroute",
  "parameters": [{
    "type": "object",
    "properties": [{
      "type": "simple",
      "name": "osrmurl",
      "position": 0
    }, {
      "type": "simple",
      "name": "osrmurlAlternativa",
      "position": 1
    }, {
      "type": "object",
      "name": "panel",
      "properties": [{
        "type": "simple",
        "name": "position",
        "possibleValues": ["TL", "TR", "BL", "BR"],
        "position": 0
      }],
      "position": 2
    }, {
      "type": "array",
      "name": "conflictedPlugins",
      "position": 3
    }, {
      "type": "simple",
      "name": "urlGeocoderInverso",
      "position": 4
    }, {
      "type": "simple",
      "name": "searchstreetUrl",
      "position": 5
    },
    {
      "type": "simple",
      "name": "searchstreetNormalizar",
      "position": 6
    }]
  }],
  "files": {
    "ol": {
      "scripts": ["findroute.ol.min.js"],
      "styles": ["findroute.ol.min.css"]
    }
  },
  "metadata": {
    "name": "Findroute",
    "description": "Plugin de búsqueda de rutas OSRM",
    "text": "Plugin para cálculo de rutas utilizando Open Source Routing Machine (OSRM). Permite calcular rutas entre puntos con diferentes modos de locomoción.",
    "version": "1.0.0",
    "date": "Diciembre, 2025",
    "author": "Servicio de Transformación Digital",
    "org": "Instituto de Estadística y Cartografía. Junta de Andalucía",
    "tags": "idee,plugin,rutas,osrm",
    "icon": "./facade/assets/icons/icons.svg"
  }
}
